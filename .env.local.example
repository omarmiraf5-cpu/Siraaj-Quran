# ── Supabase ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — server-only, NEVER expose this to the browser or
# commit it. Needed for the admin portal to invite real teacher accounts
# (Settings → API → service_role, "secret" column).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Yearly plan encryption ────────────────────────────────────────
# The key the individualized yearly Qur'an plans are encrypted under.
# Everything a teacher writes about a child in a plan — titles, milestone
# descriptions, progress notes, alert text — is sealed with AES-256-GCM
# before it reaches Postgres, so the database never holds the plaintext.
#
# Generate one with:   openssl rand -base64 32
#
# Server-only: no NEXT_PUBLIC_ prefix, so it is never inlined into a
# browser bundle. Without it the yearly-plan module refuses to serve
# rather than storing anything in the clear — every request answers 503.
#
# Back this up somewhere other than the database. Lose it and every
# existing plan's wording becomes permanently unreadable; the dates,
# targets and progress figures survive, the teacher's words do not.
PLAN_ENCRYPTION_KEY=

# Set only while rotating the key above: move the old value here, put the
# new one in PLAN_ENCRYPTION_KEY, and rows written under either still
# open. Anything re-saved afterwards is written under the new key. Remove
# this once everything has been re-saved.
# PLAN_ENCRYPTION_KEY_PREVIOUS=

# ── Signup emails ─────────────────────────────────────────────────
# Each time a school finishes signing up at /onboard, two emails go out
# through Resend: a heads-up to NEW_SCHOOL_ALERT_EMAIL (src/lib/site.ts),
# and a welcome to the school's new admin. Get a key at https://resend.com
# → API Keys, from an account opened with NEW_SCHOOL_ALERT_EMAIL. The
# welcome also needs mydiiwaan.com verified under Resend → Domains, since
# it comes from EMAIL_FROM. Server-only. Without the key, signups work
# exactly the same; the emails are just skipped (and the server log says so).
RESEND_API_KEY=

# ── Demo showcase deployment only ─────────────────────────────────
# Set to "true" ONLY on the demo deployment used to show the product to
# prospective schools. It puts the tap-to-auto-fill sample logins on the
# sign-in screen. Leave it unset (or anything other than "true") on the
# real school-facing site — the block is then stripped from the bundle
# at build time, so the sample credentials never ship there at all.
NEXT_PUBLIC_SHOW_DEMO=false
