# Copy this file to android/keystore.properties and fill in the passwords.
# keystore.properties is gitignored. Never commit it or the .jks file.
#
# storeFile is relative to the android/ directory, so the line below means
# android/mydiiwaan-upload.jks. An absolute path works too.
# The store password and the key password are the same.
storeFile=mydiiwaan-upload.jks
storePassword=REPLACE_WITH_THE_UPLOAD_KEY_PASSWORD
keyAlias=mydiiwaan-upload
keyPassword=REPLACE_WITH_THE_UPLOAD_KEY_PASSWORD
