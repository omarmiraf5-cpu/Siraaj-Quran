require "fileutils"
require "securerandom"

# MyDiiwaan iOS release.
#
# This never submits the app for App Store review. `beta` uploads a build to
# TestFlight and stops. `register` only creates the bundle id and the App
# Store Connect record, if they are not there yet.
#
# Signing reuses the Apple Distribution certificate the team already has
# (certificate id M6TPLDDU24, team T6L2L5B4QH). A new certificate is created
# only when ALLOW_NEW_DISTRIBUTION_CERTIFICATE=true and the .p12 secrets are
# absent. Apple allows very few distribution certificates, so that switch is
# for the one time the private key cannot be found.

default_platform(:ios)

APP_ID = "com.mydiiwaan.app"
APP_NAME = "MyDiiwaan"
SKU = "mydiiwaan-ios"
XCODEPROJ = "App/App.xcodeproj"
WORKSPACE = "App/App.xcworkspace"
SCHEME = "App"
KEYCHAIN_NAME = "mydiiwaan-build"
KEYCHAIN_PASSWORD = ENV["KEYCHAIN_PASSWORD"] || SecureRandom.hex(24)

platform :ios do
  desc "Register com.mydiiwaan.app and create the MyDiiwaan app in App Store Connect if needed"
  lane :register do
    register_app(asc_api_key)
  end

  desc "Build and upload to TestFlight. Does not submit for App Store review."
  lane :beta do
    api_key = asc_api_key
    register_app(api_key)
    install_distribution_certificate(api_key)

    build = next_build_number(api_key)
    version = ENV.fetch("MARKETING_VERSION", "1.0.0")
    team = ENV.fetch("APPLE_TEAM_ID")
    key_path = ENV.fetch("ASC_KEY_PATH")

    # Automatic signing, with the API key so Xcode can download a profile.
    # The distribution identity is already in the keychain, so Xcode reuses
    # it instead of minting another certificate. A profile is not fetched
    # with get_provisioning_profile on purpose: manual profiles would ignore
    # that identity and can force a new one.
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath \"#{key_path}\"",
      "-authenticationKeyID \"#{ENV.fetch("ASC_KEY_ID")}\"",
      "-authenticationKeyIssuerID \"#{ENV.fetch("ASC_ISSUER_ID")}\""
    ].join(" ")
    signing = "DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Automatic MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}"

    # Archive only. The ipa is exported below with method app-store-connect,
    # which current Xcode expects. gym's own export still writes "app-store".
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      destination: "generic/platform=iOS",
      skip_package_ipa: true,
      xcargs: "#{auth} #{signing}"
    )

    archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    export_dir = File.expand_path("build")
    FileUtils.mkdir_p(export_dir)
    plist = File.join(export_dir, "ExportOptions.plist")
    File.write(plist, <<~XML)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key><string>app-store-connect</string>
        <key>teamID</key><string>#{team}</string>
        <key>signingStyle</key><string>automatic</string>
        <key>uploadSymbols</key><true/>
        <key>manageAppVersionAndBuildNumber</key><false/>
      </dict>
      </plist>
    XML
    sh(
      "xcodebuild", "-exportArchive",
      "-archivePath", archive,
      "-exportPath", export_dir,
      "-exportOptionsPlist", plist,
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path,
      "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
      "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID")
    )
    ipa = Dir[File.join(export_dir, "*.ipa")].first
    UI.user_error!("Export did not produce an ipa in #{export_dir}") if ipa.nil?

    # skip_submission uploads the file and does not send it to testers or to review.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )

    UI.success("Uploaded version #{version} build #{build} to TestFlight. It was not submitted for review.")
  end
end

def asc_api_key
  key_path = ENV["ASC_KEY_PATH"].to_s
  UI.user_error!("ASC_KEY_PATH is not set. The workflow should decode ASC_KEY_P8_BASE64 first.") if key_path.empty?
  UI.user_error!("APPLE_TEAM_ID is not set.") if ENV["APPLE_TEAM_ID"].to_s.empty?
  UI.user_error!("ASC_KEY_ID is not set.") if ENV["ASC_KEY_ID"].to_s.empty?
  UI.user_error!("ASC_ISSUER_ID is not set.") if ENV["ASC_ISSUER_ID"].to_s.empty?
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    duration: 1200,
    in_house: false
  )
end

# fastlane 2.241's `produce` lane still signs in with an Apple ID password
# (it ignores an API key and then calls Spaceship.login). A cloud runner
# cannot type that password, so this does the same two creates with the
# token `app_store_connect_api_key` already installed:
#   bundle id com.mydiiwaan.app on the developer portal
#   App Store Connect app "MyDiiwaan", primary language en-US, SKU mydiiwaan-ios
# If Apple rejects the name, create the record by hand as
# "MyDiiwaan – Qur'an School" with the same bundle id and SKU.
def register_app(_api_key)
  bundle = Spaceship::ConnectAPI::BundleId.find(APP_ID)
  if bundle
    UI.success("Bundle id #{APP_ID} already exists (#{bundle.id}).")
  else
    UI.message("Registering bundle id #{APP_ID}")
    bundle = Spaceship::ConnectAPI::BundleId.create(
      name: APP_NAME,
      platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS,
      identifier: APP_ID
    )
    UI.success("Registered bundle id #{APP_ID} (#{bundle.id}).")
  end

  app = Spaceship::ConnectAPI::App.find(APP_ID)
  if app
    UI.success("App Store Connect record for #{APP_ID} already exists (#{app.id}).")
    return
  end

  version = ENV.fetch("MARKETING_VERSION", "1.0.0")
  UI.message("Creating App Store Connect app #{APP_NAME}, SKU #{SKU}, language en-US, version #{version}")
  Spaceship::ConnectAPI::App.create(
    name: APP_NAME,
    version_string: version,
    sku: SKU,
    primary_locale: "en-US",
    bundle_id: APP_ID,
    platforms: [Spaceship::ConnectAPI::Platform::IOS]
  )
  created = Spaceship::ConnectAPI::App.find(APP_ID)
  if created.nil?
    UI.user_error!(<<~MSG)
      The App Store Connect record was not found after create.
      If the name MyDiiwaan is already taken, create it by hand as "MyDiiwaan – Qur'an School" with bundle id #{APP_ID} and SKU #{SKU}, primary language English, then run testflight again.
    MSG
  end
  UI.success("Created App Store Connect app #{APP_NAME} (#{created.id}). Not submitted for review.")
end

def next_build_number(api_key)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_ID,
    platform: "ios",
    initial_build_number: 0
  )
  number = latest.to_i + 1
  UI.success("Next TestFlight build number is #{number} (latest on TestFlight was #{latest}).")
  number
end

def keychain_path
  File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}-db")
end

def install_distribution_certificate(api_key)
  prepare_keychain
  p12 = ENV["IOS_DIST_CERT_P12_PATH"].to_s
  if !p12.empty? && File.exist?(p12) && File.size(p12).positive?
    password = ENV["IOS_DIST_CERT_PASSWORD"].to_s
    UI.user_error!("IOS_DIST_CERT_PASSWORD is empty. It is the password of the existing distribution certificate (M6TPLDDU24).") if password.empty?
    import_p12(p12, password)
    UI.success("Imported the existing distribution certificate. No new certificate will be created.")
  elsif ENV["ALLOW_NEW_DISTRIBUTION_CERTIFICATE"] == "true"
    UI.important("Creating a new Apple Distribution certificate. This uses one of the few certificate slots. Save the .p12 artifact into IOS_DIST_CERT_P12_BASE64 and IOS_DIST_CERT_PASSWORD, then do not do this again.")
    get_certificates(
      api_key: api_key,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      development: false,
      force: false,
      keychain_path: keychain_path,
      keychain_password: KEYCHAIN_PASSWORD,
      output_path: "fastlane/certs-out",
      filename: "AppleDistribution"
    )
    export_new_p12
  else
    UI.user_error!(<<~MSG)
      Refusing to build. The team already has an Apple Distribution certificate (M6TPLDDU24) and the certificate limit is low.

      Put that certificate's exported .p12 into the GitHub secrets IOS_DIST_CERT_P12_BASE64 and IOS_DIST_CERT_PASSWORD so this build can reuse it.

      Only if that private key is gone for good: run this workflow again with "allow a new distribution certificate" turned on, once. Save the file it attaches, then turn the switch off.
    MSG
  end
  assert_distribution_identity
end

def prepare_keychain
  sh("security", "delete-keychain", keychain_path, log: false) rescue nil
  sh("security", "create-keychain", "-p", KEYCHAIN_PASSWORD, keychain_path, log: false)
  sh("security", "set-keychain-settings", "-lut", "3600", keychain_path, log: false)
  sh("security", "unlock-keychain", "-p", KEYCHAIN_PASSWORD, keychain_path, log: false)
  sh("security", "default-keychain", "-s", keychain_path, log: false)
  existing = sh("security", "list-keychains", "-d", "user", log: false)
  paths = existing.scan(/"([^"]+)"/).flatten
  paths.unshift(keychain_path) unless paths.include?(keychain_path)
  sh("security", "list-keychains", "-d", "user", "-s", *paths, log: false)
end

def import_p12(path, password)
  sh(
    "security", "import", path,
    "-k", keychain_path,
    "-P", password,
    "-A",
    "-t", "cert",
    "-f", "pkcs12",
    "-T", "/usr/bin/codesign",
    "-T", "/usr/bin/security",
    log: false
  )
  sh(
    "security", "set-key-partition-list",
    "-S", "apple-tool:,apple:,codesign:",
    "-s",
    "-k", KEYCHAIN_PASSWORD,
    keychain_path,
    log: false
  )
end

def export_new_p12
  FileUtils.mkdir_p("fastlane/certs-out")
  export_password = SecureRandom.hex(24)
  p12_out = "fastlane/certs-out/AppleDistribution.p12"
  sh(
    "security", "export",
    "-k", keychain_path,
    "-t", "identities",
    "-f", "pkcs12",
    "-o", p12_out,
    "-P", export_password,
    log: false
  )
  File.write("fastlane/certs-out/p12-password.txt", export_password)
  UI.success("Wrote fastlane/certs-out/AppleDistribution.p12. The workflow attaches it. The password is in p12-password.txt and the job summary, not in this log.")
end

def assert_distribution_identity
  identities = sh("security", "find-identity", "-v", "-p", "codesigning", keychain_path)
  return if identities.include?("Apple Distribution") || identities.include?("iPhone Distribution")
  UI.user_error!(<<~MSG)
    The keychain has no Apple Distribution identity, so the archive was not started.
    Xcode would otherwise create a new certificate, and the team is already near the limit (existing certificate M6TPLDDU24).

    Identities found:
    #{identities}
  MSG
end
